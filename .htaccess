<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Prevent directory browsing and MultiViews conflicts (commented out for host compatibility)
    # Options -Indexes -MultiViews

    # Block direct access to critical app directories
    RewriteRule ^(app|config|database|routes|storage|vendor)($|/) - [F,L]

    # Rewrite assets and public files transparently if requesting from root but they are in public/
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Redirect trailing slashes
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]

    # If the requested filename is not a directory or a file, rewrite to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
