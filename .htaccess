<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Prevent directory browsing
    Options -Indexes

    # Block direct access to critical app directories
    RewriteRule ^(app|config|database|routes|storage|vendor)($|/) - [F,L]

    # Redirect trailing slashes
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]

    # If the requested filename is not a directory or a file, rewrite to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
