# Digitalium Group — Environment Configuration Template
# Copier ce fichier en .env et ajuster les valeurs pour chaque environnement.
# Le fichier .env est ignoré par Git (.gitignore). Ne jamais le committer.
#
# DÉPLOIEMENT HOSTINGER HPANEL :
#   Méthode : Git Integration → KODEX-cloud/Digitalium | Branch: main | Target: public_html
#   Étapes :
#     1. Connecter sur hpanel.hostinger.com → Websites → digitaliumgroup.com → File Manager
#     2. Créer public_html/.env avec les valeurs PRODUCTION ci-dessous
#     3. Déclencher Pull depuis hPanel → Git → Pull
#     4. Via Terminal SSH : php database/master_migration.php

# ─── ENVIRONMENT ──────────────────────────────────────────────────────────────
# development : erreurs affichées, cache désactivé — pour développement local
# production  : erreurs masquées, cache activé — pour Hostinger
APP_ENV=production
APP_DEBUG=false

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Production Hostinger : credentials dans hPanel → Databases → MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=digitalium_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ─── SECURITY ─────────────────────────────────────────────────────────────────
# Générer une clé forte pour la production :
# php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=4f923b784a92c0199e8293e9da2884a0d927d6d5ef18c7c90b0be83984d76fe2

# ─── COMPTE ADMIN ─────────────────────────────────────────────────────────────
# Le compte `admin` n'est créé par la migration que s'il n'existe pas encore.
# Son mot de passe n'est JAMAIS réécrit par un déploiement.
#
# Première installation : renseigner ADMIN_PASSWORD ci-dessous, ou laisser vide
# pour qu'un mot de passe soit engendré au hasard et affiché une seule fois dans
# le rapport de la migration.
#
# Mot de passe perdu : renseigner ADMIN_PASSWORD, poser ADMIN_PASSWORD_RESET=1,
# relancer `php database/master_migration.php`, puis RETIRER les deux lignes.
# Les laisser en place réécrirait le mot de passe à chaque déploiement — c'est
# exactement le défaut que ce réglage remplace.
ADMIN_PASSWORD=
ADMIN_PASSWORD_RESET=0
