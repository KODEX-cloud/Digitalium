<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Prevent directory browsing and MultiViews conflicts (commented out for host compatibility)
    # Options -Indexes -MultiViews

    # Redirect trailing slashes
    RewriteRule ^(.*)/$ /$1 [L,R=301]

    # If the requested filename is not a directory or a file, rewrite to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
